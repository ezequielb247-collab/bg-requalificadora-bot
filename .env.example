PORT=3000
BUSINESS_NAME=Nome da Empresa

# Pasta onde o Baileys salva a sessao do aparelho vinculado.
# No Render, use uma pasta dentro do Persistent Disk, por exemplo:
# SESSION_DIR=/var/data/auth_info_baileys
SESSION_DIR=./auth_info_baileys

# Por padrao o bot ignora grupos.
IGNORE_GROUPS=true

# Numeros dos atendentes que recebem aviso quando o cliente demonstra interesse.
# Use DDI + DDD + numero, separados por virgula.
ATTENDANT_NUMBERS=5511999999999,5511888888888

# Google Sheets
GOOGLE_SHEETS_ID=
SHEET_CONVERSAS=Conversas
SHEET_LEADS=Leads

# Opcao 1: cole o JSON inteiro da conta de servico em uma variavel.
GOOGLE_CREDENTIALS_JSON=

# Opcao 2: informe o caminho do arquivo JSON de credenciais.
GOOGLE_APPLICATION_CREDENTIALS=

# Nao use mais estas variaveis da Cloud API:
# WHATSAPP_TOKEN
# PHONE_NUMBER_ID
# VERIFY_TOKEN
