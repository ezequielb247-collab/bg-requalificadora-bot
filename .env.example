PORT=3000
BUSINESS_NAME=BG GNV Macaé

# Sessao do aparelho vinculado.
# No Render com Persistent Disk:
SESSION_DIR=/var/data/auth_info_baileys

IGNORE_GROUPS=true
LOG_LEVEL=error

# Numeros que recebem aviso quando o cliente escolhe falar com atendente.
# Use DDI + DDD + numero, separados por virgula.
ATTENDANT_NUMBERS=5522991016400,5521997324933,5522999435026

# Estabilidade e reconexao
RECONNECT_BASE_DELAY_MS=3000
RECONNECT_MAX_DELAY_MS=60000
WATCHDOG_INTERVAL_MS=60000
SEND_RETRY_ATTEMPTS=3
MESSAGE_ID_TTL_MS=600000

# Google Sheets
GOOGLE_SHEETS_ID=
SHEET_CONVERSAS=Conversas
SHEET_LEADS=Leads
SHEET_VALORES=Valores
SHEET_ATENDIMENTO_HUMANO=AtendimentoHumano

# Opcao 1: JSON inteiro da conta de servico.
GOOGLE_CREDENTIALS_JSON=

# Opcao 2: caminho do arquivo JSON.
GOOGLE_APPLICATION_CREDENTIALS=
